{
  "_nota": "Sursa unica a regulilor pentru tichete_lib.psm1 (productie) si tichete_lib.mjs (teste vitest). Cale interzisa = prefix, comparat lowercase cu '/'. SalariiPage NU are fisier propriu: e functia din src/App.jsx => regiuni_interzise + cuvinte_interzise_diff.",
  "status_permise": ["deschis", "atribuit"],
  "subcategorii_permise": ["eroare_erp", "cerere_functie"],
  "max_descriere": 8000,
  "max_titlu": 300,
  "max_linii_diff": 1500,
  "prag_effort_medium": 400,
  "cai_interzise": [
    "supabase/",
    ".github/",
    "src/salariipage",
    "scripts/tichete_dimineata/",
    "scripts/paw/",
    "docs/paw/",
    "claude.md",
    "package.json",
    "package-lock.json",
    "vercel.json",
    "vite.config",
    "vitest.config",
    "index.html",
    ".env",
    "api/"
  ],
  "extensii_interzise": [".sql"],
  "regiuni_interzise": [
    { "fisier": "src/App.jsx", "functie": "SalariiPage" }
  ],
  "cuvinte_interzise_diff": ["SalariiPage", "salaryAccess", "service_role", "is_owner", "user_module_access"],
  "marcaje_rezultat": ["REZULTAT_REVIEW", "REZULTAT_TICHET", "PAW_GATA", "PAW_EROARE"]
}
