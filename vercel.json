{
  "functions": {
    "api/seap-import.js": {
      "maxDuration": 300,
      "memory": 3009
    },
    "api/cad-parse.js": {
      "maxDuration": 120,
      "memory": 2048
    },
    "api/plansa-felii.js": {
      "maxDuration": 300,
      "memory": 3009,
      "includeFiles": "node_modules/{pdfjs-dist,@napi-rs}/**"
    },
    "api/pdf-sparge.js": {
      "maxDuration": 300,
      "memory": 3009
    },
    "api/hr-drive-import.js": {
      "maxDuration": 300,
      "memory": 3009
    },
    "api/hr-fise-import.js": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "headers": [
    {
      "source": "/redari/raspuns/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!redari/raspuns/[^/]+/?$|redari/informare/?$|assets/|icon-192\\.png$|icon-512\\.png$|icon-maskable-512\\.png$|apple-touch-icon\\.png$|manifest\\.webmanifest$|favicon\\.ico$).*)",
      "has": [
        {
          "type": "host",
          "value": "redari.gazpet.ro"
        }
      ],
      "destination": "https://pontaj-pro-sooty.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
